# Provedor de modelo — qualquer endpoint compatível com a API da OpenAI.
# Padrão: Ollama local (sem custo, sem token). Veja modulos/00-setup/README.md.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b-instruct
# Ollama ignora a chave; provedores remotos exigem.
LLM_API_KEY=
# Opcional, só para modelos remotos de raciocínio (ex.: low, medium). Deixe vazio no Ollama.
LLM_REASONING_EFFORT=
