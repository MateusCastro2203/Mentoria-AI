{
  "name": "mentoria-ia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verificar": "tsx --env-file-if-exists=.env scripts/verificar.ts",
    "test": "pnpm -r --no-bail --if-present test",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "test:solucao": "pnpm -r --no-bail --if-present test:solucao"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mentoria/llm": "workspace:*",
    "zod": "^4.6.5"
  }
}
