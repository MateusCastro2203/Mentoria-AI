{
  "name": "@mentoria/ex01-llms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude \"test/desafio/**\"",
    "test:desafio": "vitest run test/desafio",
    "typecheck": "tsc --noEmit",
