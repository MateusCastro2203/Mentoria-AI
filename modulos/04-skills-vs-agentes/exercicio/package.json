    "demo:agente": "tsx --env-file-if-exists=../../../.env demo/agente.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mentoria/curador": "workspace:*",
    "@mentoria/llm": "workspace:*"
  }
}
