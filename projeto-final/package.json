{
  "name": "@mentoria/curador",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude \"test/desafio/**\"",
    "typecheck": "tsc --noEmit",
    "m01:temperaturas": "tsx --env-file-if-exists=../.env scripts/m01-temperaturas.ts",
    "test:solucao": "vitest run --config vitest.solucao.config.ts",
    "m01:temperaturas:solucao": "SOLUCAO=1 tsx --env-file-if-exists=../.env scripts/m01-temperaturas.ts",
    "m02:comparar": "tsx --env-file-if-exists=../.env scripts/m02-comparar.ts",
    "m02:comparar:solucao": "SOLUCAO=1 tsx --env-file-if-exists=../.env scripts/m02-comparar.ts",
    "test:desafio": "vitest run test/desafio",
    "m03:avaliar": "tsx --env-file-if-exists=../.env scripts/m03-avaliar.ts",
    "m03:avaliar:solucao": "SOLUCAO=1 tsx --env-file-if-exists=../.env scripts/m03-avaliar.ts",
    "m03:ver": "promptfoo view",
    "m04:comparar": "tsx --env-file-if-exists=../.env scripts/m04-comparar.ts",
    "m04:comparar:solucao": "SOLUCAO=1 tsx --env-file-if-exists=../.env scripts/m04-comparar.ts",
    "m05:edicao": "tsx --env-file-if-exists=../.env scripts/m05-edicao.ts",
    "m05:edicao:solucao": "SOLUCAO=1 tsx --env-file-if-exists=../.env scripts/m05-edicao.ts",
    "mcp:fontes": "tsx scripts/mcp-fontes.ts",
    "mcp:edicao": "tsx scripts/mcp-edicao.ts"
  },
  "dependencies": {
    "@mentoria/llm": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "fast-xml-parser": "5.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "ai": "^7.0.128",
    "promptfoo": "^0.124.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./src/noticia.ts",
    "./*": "./src/*.ts"
  }
}
